---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../site-config";
import { jobs } from "../lib/experience";
import BackButton from "../components/BackButton.astro";
---

<Layout
  title={`Experiencia - ${SITE.author.fullName}`}
  description="Experiencia profesional."
>
  <main class="max-w-4xl mx-auto p-6 text-ink-page">
    <BackButton />
    <h1 class="text-3xl font-bold mt-4 mb-10">Experiencia</h1>

    <div class="flex flex-col gap-6">
      {jobs.map((job) => (
        <article class="bg-surface-2 text-ink rounded-lg p-5 border border-line hover:border-accent transition-colors duration-300">
          <div class="flex justify-between items-start flex-wrap gap-2">
            <div>
              <h2 class="font-bold text-xl">{job.role}</h2>
              <p class="text-ink-muted">{job.company}</p>
            </div>
            <span class="text-xs px-2 py-0.5 rounded-full bg-surface-inverted text-ink-muted whitespace-nowrap">
              {job.start} – {job.end}
            </span>
          </div>
          <p class="text-sm opacity-80 mt-3">{job.description}</p>
        </article>
      ))}
    </div>
  </main>
</Layout>