---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../site-config";
import { jobs } from "../lib/experience";
---

<Layout
  title={`Experiencia - ${SITE.author.fullName}`}
  description="Experiencia profesional."
>
  <main class="max-w-4xl mx-auto p-6 text-white">
    <a href="/" class="text-sm opacity-70 hover:opacity-100 hover:text-primary-500">&larr; Volver al inicio</a>
    <h1 class="text-3xl font-bold mt-4 mb-10">Experiencia</h1>
    <ul class="flex flex-col gap-8">
      {jobs.map((job) => (
        <li class="border-b border-darkslate-400 pb-6 last:border-none">
          <div class="flex justify-between items-baseline flex-wrap gap-1">
            <h2 class="font-bold text-xl">{job.role} · {job.company}</h2>
            <span class="text-sm opacity-60">{job.start} – {job.end}</span>
          </div>
          <p class="text-sm opacity-80 mt-2">{job.description}</p>
        </li>
      ))}
    </ul>
  </main>
</Layout>