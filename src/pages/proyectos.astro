---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { SITE } from "../site-config";
import ProjectFilter from "../components/ProjectFilter.svelte";
import BackButton from "../components/BackButton.astro";

const statusPriority: Record<string, number> = {
  en_desarrollo: 0,
  en_pausa: 1,
  terminado: 2,
};

const allProjects = (await getCollection("projects"))
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags,
    category: p.data.category,
    type: p.data.type,
    status: p.data.status,
    repoUrl: p.data.repoUrl,
    demoUrl: p.data.demoUrl,
    date: p.data.date,
  }))
  .sort((a, b) => {
    if (a.type !== b.type) {
      return a.type === "academico" ? -1 : 1;
    }
    if (a.type === "academico") {
      return (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0);
    }
    return (statusPriority[a.status] ?? 3) - (statusPriority[b.status] ?? 3);
  });
---

<Layout
  title={`Proyectos - ${SITE.author.fullName}`}
  description="Proyectos de software en los que he trabajado."
>
  <main class="max-w-4xl mx-auto p-6 text-ink-page">
    <BackButton />
    <h1 class="text-3xl font-bold mt-4 mb-10">Proyectos</h1>

    <ProjectFilter client:load projects={allProjects} />
  </main>
</Layout>
