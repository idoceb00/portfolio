---
interface Props {
  items: string[];
}
const { items } = Astro.props;
const track = [...items, ...items];
---

<div
  class="tech-marquee relative overflow-hidden my-4"
  style="width: 100%;"
>
  <div
    class="marquee-track flex gap-3 w-max"
    style={`animation-duration: ${items.length * 1.8}s`}
  >
    {track.map((item) => (
      <span class="chip shrink-0 px-3 py-1 rounded-full border border-darkslate-400 text-sm whitespace-nowrap">
        {item}
      </span>
    ))}
  </div>
</div>

<style>
  .tech-marquee {
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }
  .marquee-track {
    animation-name: marquee-scroll;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>