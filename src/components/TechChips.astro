---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="flex gap-2 flex-wrap my-4">
  {items.map((item, i) => (
    <span
      class="chip px-3 py-1 rounded-full border border-darkslate-400 text-sm opacity-0 hover:border-primary-500 hover:text-primary-500 transition-colors cursor-default"
      style={`animation-delay: ${i * 90}ms`}
    >
      {item}
    </span>
  ))}
</div>

<style>
  .chip {
    animation: chip-in 0.5s ease-out forwards;
  }
  @keyframes chip-in {
    from { opacity: 0; transform: translateY(6px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>