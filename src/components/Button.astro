---
interface Props {
  rounded?: boolean;
  class?: string;
}

const { rounded, ...props } = Astro.props;
---

<button
  {...props}
  class={`h-full w-fit text-xl max-h-[50px] shadow-custom shadow-accent-deep active:shadow-none active:translate-x-[3px] active:translate-y-[3px] text-ink px-5 py-2 border border-accent hover:text-accent transition-colors duration-100 ease-in-out bg-surface-inverted cursor-pointer ${
    rounded ? "rounded-full" : "rounded-lg"
  } ${props.class ?? ""}`}
>
  <slot />
</button>
