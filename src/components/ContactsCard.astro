---
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
import { SITE } from "../site-config";
---

<Card colSpan="md:col-span-1" rowSpan="lg:row-span-4">
  <div class="h-full">
    <header class="flex items-center">
      <h2 class="text-ink text-xl font-bold">
        ¡Empecemos a trabajar juntos!
      </h2>
    </header>
    <address class="flex flex-col mt-4">
      <h2 class="text-ink-muted">Datos de contacto</h2>
      <p class="text-sm">{SITE.links.email}</p>
      <p>{SITE.location.city}, {SITE.location.countryName}</p>
    </address>
    <div class="flex flex-col mt-4 w-fit">
      <h2 class="text-ink-muted">Redes sociales</h2>
      <ul>
        <li>
          <a href={LINKS.linkedin} target="_blank">Linkedin</a>
        </li>
        <li>
          <a href={LINKS.github} target="_blank">Github</a>
        </li>
      </ul>
    </div>
  </div>
</Card>
