---
import Card from "./Card/index.astro";
import { jobs } from "../lib/experience";
---

<Card
  title="Experiencia"
  body={`${jobs.length} etapa${jobs.length === 1 ? "" : "s"} profesional${jobs.length === 1 ? "" : "es"}.`}
  href="/experiencia"
  bgColor="squares-pattern"
  colSpan="md:col-span-1 md:col-start-2 lg:col-start-2"
  rowSpan="md:row-span-1 lg:row-start-7 lg:row-span-2"
  height="h-full"
/>